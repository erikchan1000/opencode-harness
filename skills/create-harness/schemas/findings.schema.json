{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness/schemas/findings.schema.json",
  "title": "Harness findings",
  "description": "Phase 1 research output for one slice (an empty list is valid: the slice found nothing); the merged list of findings consumed by build_pipelines.py --findings-json. Mirrors templates/finding.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Finding" }
    }
  },
  "$defs": {
    "FindingId": { "type": "string", "pattern": "^[A-Z]+\\d+$" },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "lines"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "lines": { "type": "string", "minLength": 1, "description": "Line or range, e.g. 123 or 123-145." },
        "trigger": { "type": "string" },
        "symptom": { "type": "string" }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "severity", "area", "title", "evidence", "depends_on",
        "touches_files", "root_cause", "fix_sketch", "test_sketch"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/FindingId" },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "area": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Evidence" } },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/FindingId" } },
        "touches_files": { "type": "array", "items": { "type": "string" } },
        "root_cause": { "type": "string" },
        "fix_sketch": { "type": "string" },
        "test_sketch": { "type": "string" },
        "out_of_scope_followups": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["todo", "pending", "in_progress", "blocked", "done", "deferred"] }
      }
    }
  }
}

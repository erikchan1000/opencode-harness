{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness/schemas/review-verdict.schema.json",
  "title": "Harness review verdict",
  "description": "Output of the harness-review gate: a PASS / NEEDS_FIX / BLOCKED verdict plus the review items (fields mirror skills/pr-review/scripts/parse_output.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "items", "blocker"],
  "properties": {
    "verdict": { "enum": ["PASS", "NEEDS_FIX", "BLOCKED"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "category", "file", "line", "problem", "fix", "blocking"],
        "properties": {
          "finding_id": { "type": "string" },
          "severity": { "type": "string" },
          "category": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "problem": { "type": "string" },
          "fix": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "blocker": { "type": ["string", "null"], "description": "Reason the review could not complete; non-null exactly when verdict is BLOCKED." }
  },
  "if": { "properties": { "verdict": { "const": "BLOCKED" } }, "required": ["verdict"] },
  "then": { "properties": { "blocker": { "type": "string", "minLength": 1 } } },
  "else": { "properties": { "blocker": { "type": "null" } } }
}
